{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "LTO Backup Test Script Settings",
  "description": "RepoUtils test pipeline for emulator-backed .NET tests.",
  "plugins": [
    {
      "name": "DotNetTest",
      "stageLabel": "test",
      "enabled": true,
      "project": "..\\..\\..\\src\\MaksIT.LTO.Tests",
      "resultsDir": "..\\..\\..\\test-results"
    },
    {
      "name": "QualityGate",
      "stageLabel": "qualityGate",
      "enabled": true,
      "coverageThreshold": 0,
      "scanVulnerabilities": false
    },
    {
      "name": "CoverageBadges",
      "stageLabel": "report",
      "enabled": true,
      "badgeFormat": "shields",
      "readmePath": "..\\..\\..\\README.md",
      "badges": [
        {
          "label": "Line Coverage",
          "metric": "line"
        },
        {
          "label": "Branch Coverage",
          "metric": "branch"
        },
        {
          "label": "Method Coverage",
          "metric": "method"
        }
      ],
      "colorThresholds": {
        "brightgreen": 80,
        "green": 60,
        "yellowgreen": 40,
        "yellow": 20,
        "orange": 10,
        "red": 0
      }
    }
  ]
}
